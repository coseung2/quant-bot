# ─────────────────────────────────────────────
# Bybit F_DCA bot — 환경설정 예시
# 1) cp .env.example .env
# 2) 아래 값을 채운다
# 3) .env 는 절대 Git에 올리지 않는다
# ─────────────────────────────────────────────

# ── [필수] Bybit API ──
# 권한: 읽기 + 선물 거래만. 출금 권한은 절대 켜지 마세요.
# IP 화이트리스트를 켜는 것을 권장합니다.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── [필수] 총 캠페인 수량 (BTC) ──
# 세 슬롯(0.60 / 0.25 / 0.15)으로 나뉘어 진입합니다.
# 최소 0.002 BTC. 처음에는 아주 작게 시작하세요.
POSITION_SIZE_BTC=

# ── 거래소 연결 ──
# true = Bybit Testnet. 실제 검증 전까지 true 유지.
BYBIT_TESTNET=true

# 종목 (기본: BTCUSDT 무기한 선물)
# SYMBOL=BTC/USDT:USDT

# ── 레버리지 ──
# 거래소에서 실제 레버리지를 읽지 못할 때만 쓰는 폴백 값입니다.
# AUTO_SET_LEVERAGE=true 로 두면 시작 시 이 값으로 레버리지를 설정합니다.
# ENTRY_LEVERAGE=10
# AUTO_SET_LEVERAGE=false

# ── 전략 모드 ──
# accumulate: 적립형(기본) · cyclic: 순환형
# BOT1_PYR_MODE=accumulate

# ── Telegram 알림 (선택) ──
# 비워 두면 알림만 생략되고 봇은 정상 동작합니다.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── 라벨 (선택) ──
# BOT_NAME=my-bybit-bot
# BOT_STRATEGY_NAME=f_dca

# ── 상태 파일 (고급 · 기본값 권장) ──
# BOT1_F_STATE_FILE=bot1_f_state.json
# BOT1_DCA_STATE_FILE=bot1_dca_state.json
# BOT1_F_SESSION_LOCK_FILE=bot1_f_session.lock

# ── 상태 알림 주기 (고급) ──
# BOT1_F_STATUS_INTERVAL_SEC=14400
# BOT1_F_STATUS_MIN_GAP_SEC=600
# BOT1_F_SIGNAL_STATUS_INTERVAL_SEC=3600
